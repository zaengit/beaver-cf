{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beaver-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beaver-db",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "beaver-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "MEDIA_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "TRUST_PROXY": "true",
    "PUBLIC_CACHE_TTL_SECONDS": "300",
    "PASSWORD_HASH_ITERATIONS": "120000",
    "ADMIN_2FA_ENABLED": "false",
    "CONTACT_TURNSTILE_REQUIRED": "false"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}

# Cloudflare Worker local secrets. Copy to .dev.vars; never commit that file.

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
SESSION_SECRET=
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=

# Optional edge-compatible authentication settings.
ADMIN_2FA_ENABLED=false
# ADMIN_2FA_SECRET=
PASSWORD_HASH_ITERATIONS=120000

# Public contact form protection. Contact submissions are stored in D1;
# this project does not send email.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_TURNSTILE_REQUIRED=false
